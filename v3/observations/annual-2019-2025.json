  "metric_definitions": {
    "gdp_current": {
      "label": "地区生产总值",
      "unit": "亿元",
      "measurement": "current_price_level",
      "grade": "official_statement",
      "description": "现价地区生产总值总量，不得据相邻年份现价比值推导可比价增速"
    },
    "gdp_real_yoy": {
      "label": "GDP 同比增长（可比价）",
      "unit": "%",
      "measurement": "constant_price_growth",
      "grade": "official_statement",
      "description": "来源公报发布的可比价同比增速"
    },
    "primary_current": {
      "label": "第一产业增加值",
      "unit": "亿元",
      "measurement": "current_price_level",
      "grade": "official_statement",
      "description": "现价增加值"
    },
    "secondary_current": {
      "label": "第二产业增加值",
      "unit": "亿元",
      "measurement": "current_price_level",
      "grade": "official_statement",
      "description": "现价增加值"
    },
    "tertiary_current": {
      "label": "第三产业增加值",
      "unit": "亿元",
      "measurement": "current_price_level",
      "grade": "official_statement",
      "description": "现价增加值"
    },
    "industry_growth": {
      "label": "规上工业增加值同比",
      "unit": "%",
      "measurement": "reported_growth",
      "grade": "official_statement",
      "description": "同比增速，不是绝对工业产出水平"
    },
    "industry_invest_growth": {
      "label": "工业固定资产投资同比",
      "unit": "%",
      "measurement": "reported_growth",
      "grade": "official_statement",
      "description": "同比增速，且不等于模拟模型投资强度系数"
    },
    "retail_current": {
      "label": "社会消费品零售总额",
      "unit": "亿元",
      "measurement": "nominal_level",
      "grade": "official_statement",
      "description": "现价总量，统计口径可能因经济普查修订"
    },
    "budget_current": {
      "label": "地方一般公共预算收入",
      "unit": "亿元",
      "measurement": "nominal_level",
      "grade": "official_statement",
      "description": "账面总量；2025 增速与公报同比说法需进一步复核"
    }
  },
